# --- LLM provider ---
# One of: ollama | openai | gemini | fake
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# Only needed if LLM_PROVIDER=gemini
GOOGLE_API_KEY=

# --- Embeddings provider ---
# One of: fake | ollama | openai
EMBEDDINGS_PROVIDER=fake
EMBEDDINGS_MODEL=nomic-embed-text
EMBEDDINGS_DIM=384

# --- PostgreSQL (checkpoints + session store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agent_runtime
POSTGRES_USER=agent_runtime
POSTGRES_PASSWORD=agent_runtime
DATABASE_URL=postgresql+asyncpg://agent_runtime:agent_runtime@localhost:5432/agent_runtime
CHECKPOINT_DATABASE_URL=postgresql://agent_runtime:agent_runtime@localhost:5432/agent_runtime

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_docs

# --- Redis (optional cache) ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# --- Search tool (optional; live web search) ---
TAVILY_API_KEY=

# --- A2A registry (agent name -> base URL) ---
A2A_REGISTRY={"researcher": "http://localhost:8000", "coder": "http://localhost:8000", "reviewer": "http://localhost:8000"}

# --- Observability ---
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-agent-runtime
